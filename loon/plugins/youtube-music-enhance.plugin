#!name=YouTube Music Enhance
#!desc=YouTube Music 独立增强：去广告、后台播放、画中画及菜单精简；运行依赖全部托管于 ProxyKit。
#!author=ProxyKit
#!homepage=https://github.com/KnowSky404/ProxyKit
#!loon_version=3.2.1(733)
#!system=iOS,iPadOS
#!tag=去广告,YouTube Music,独立增强

# YouTube Music only. Do not enable together with youtube-enhance.plugin.
# All runtime scripts are hosted in KnowSky404/ProxyKit.
# No third-party runtime script or Worker is used.

[Argument]
blockAds = switch,true,tag=屏蔽 Music 广告,desc=YouTube Music 专用：本地触发无广告播放回退
enableBackground = switch,true,tag=启用 Music 后台播放,desc=YouTube Music 专用：强制启用后台播放能力
enablePiP = switch,true,tag=启用 Music 画中画,desc=YouTube Music 专用：强制启用画中画能力
blockImmersive = switch,true,tag=屏蔽 Music 选段按钮,desc=YouTube Music 专用：隐藏播放器中的选段入口
blockUpgrade = switch,true,tag=屏蔽 Music 升级按钮,desc=YouTube Music 专用：隐藏升级入口
debug = switch,false,tag=启用调试模式,desc=仅排查问题时开启本地脚本日志

[Script]
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(player|get_watch|guide)(\?.*)?$ script-path=https://raw.githubusercontent.com/KnowSky404/ProxyKit/main/loon/scripts/youtube.music.local.response.js,tag=YouTube Music Enhance Response,requires-body=true,binary-body-mode=true,timeout=60,argument=[{blockAds},{enableBackground},{enablePiP},{blockImmersive},{blockUpgrade},{debug}],enable=true
http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.* script-path=https://raw.githubusercontent.com/KnowSky404/ProxyKit/main/loon/scripts/youtube.music.local.request.js,tag=YouTube Music Enhance Init Playback,requires-body=true,binary-body-mode=true,timeout=60,argument=[{blockAds},{debug}],enable=true

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com
